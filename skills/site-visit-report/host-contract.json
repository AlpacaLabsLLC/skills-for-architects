{
  "path": "skills/site-visit-report/SKILL.md",
  "responsibility": "Prepare a sourced site-visit record separating direct observations, participant reports, interpretations, limitations and proposed follow-ups.",
  "inputs": "Supplied task and selected source scope; exact destination only for requested persistence or application work. Load project context only when the task needs project records.",
  "owned_records": [
    "DOCUMENTS.csv (kind=site-visit)"
  ],
  "non_owned_records": [
    "PROJECT.md",
    "STUDIO.md",
    "TASKS.csv",
    "TIME.csv",
    "DOCUMENTS.csv (kind=proposal)",
    "PROJECT.md#agreement and registered agreement/contract documents",
    "INVOICES.csv",
    "ffe/items-and-schedules",
    "product-library.csv",
    "epd-library.csv",
    "ffe/jobs/input-manifests"
  ],
  "delegation": "inherit-scope-target-permissions-and-evidence",
  "modes": [
    {
      "mode": "answer"
    },
    {
      "mode": "file-read",
      "required": [
        "file.read"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "docs/workspace-model.md",
    "operations": [
      "site_visit.prepare",
      "context.resolve",
      "documents.resolve",
      "documents.register",
      "documents.query"
    ]
  }
}
