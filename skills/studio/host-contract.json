{
  "path": "skills/studio/SKILL.md",
  "responsibility": "Open, inspect or configure an Arch Studio workspace and register projects. Use for studio administration; direct domain skills and tools-only use remain available.",
  "inputs": "Supplied task and selected source scope; exact destination only for requested persistence or application work. Load project context only when the task needs project records.",
  "owned_records": [
    "STUDIO.md",
    "studio-configuration",
    "PROJECT.md (registered Status synchronization only)",
    "TASKS.csv (empty-register topology administration only)"
  ],
  "non_owned_records": [
    "PROJECT.md (all fields except authorized registered Status synchronization)",
    "TASKS.csv (task contents and lifecycle)",
    "TIME.csv",
    "DOCUMENTS.csv (kind=proposal)",
    "PROJECT.md#agreement and registered agreement/contract documents",
    "INVOICES.csv",
    "ffe/items-and-schedules",
    "product-library.csv",
    "epd-library.csv",
    "ffe/jobs/input-manifests"
  ],
  "delegation": "inherit-scope-target-permissions-and-evidence",
  "modes": [
    {
      "mode": "record-read",
      "required": [
        "file.read"
      ],
      "optional": []
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": []
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "docs/workspace-model.md",
    "operations": [
      "context.resolve",
      "studio.init",
      "studio.status",
      "studio.register",
      "studio.set-status",
      "studio.archive",
      "studio.set-naming",
      "studio.task-mode",
      "studio.preference",
      "studio.connectors"
    ]
  }
}
