      "mode": "record-read",
      "required": [
        "file.read"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "docs/workspace-model.md",
    "operations": [
      "context.resolve",
      "invoice.init",
      "invoice.allocate",
      "invoice.status",
      "invoice.append",
      "invoice.set-lifecycle"
    ]
  }
}
