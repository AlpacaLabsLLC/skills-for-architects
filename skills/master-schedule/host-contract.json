{
  "path": "skills/master-schedule/SKILL.md",
  "responsibility": "Adopt, inspect, reconcile or revise project FF&E schedules and item records. Existing library requests route to product-library; use for adopted selections, workbook reconciliation and recovery.",
  "inputs": "Supplied task and selected source scope; exact destination only for requested persistence or application work. Load project context only when the task needs project records.",
  "owned_records": [
    "ffe/items-and-schedules"
  ],
  "non_owned_records": [
    "PROJECT.md",
    "STUDIO.md",
    "TASKS.csv",
    "TIME.csv",
    "proposals/",
    "agreement/",
    "INVOICES.csv",
    "epd-library.csv",
    "ffe/jobs/input-manifests",
    "product-library.csv"
  ],
  "delegation": "inherit-scope-target-permissions-and-evidence",
  "modes": [
    {
      "mode": "record-read",
      "required": [
        "file.read"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": [
        "process.run"
      ]
    },
    {
      "mode": "workbook-read"
    },
    {
      "mode": "workbook-edit"
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "tools/workspace/ffe-records-contract.md",
    "operations": [
      "ffe_records.read",
      "ffe_records.adopt",
      "ffe_records.revise",
      "ffe_records.reconcile",
      "ffe_records.snapshot",
      "ffe_records.recover",
      "ffe_records.export",
      "workbook_preservation.compare"
    ]
  }
}
