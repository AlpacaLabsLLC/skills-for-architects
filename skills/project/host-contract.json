{
  "path": "skills/project/SKILL.md",
  "responsibility": "Initialize or inspect a project, maintain sourced current facts and record durable decisions. Use for project context or remember-this requests; other record types retain their owners.",
  "inputs": "Supplied task and selected source scope; exact destination only for requested persistence or application work. Load project context only when the task needs project records.",
  "owned_records": [
    "PROJECT.md",
    "DOCUMENTS.csv (kind=decision)"
  ],
  "non_owned_records": [
    "STUDIO.md",
    "TASKS.csv",
    "TIME.csv",
    "DOCUMENTS.csv (kind=proposal)",
    "PROJECT.md#agreement and registered agreement/contract documents",
    "INVOICES.csv",
    "ffe/items-and-schedules",
    "product-library.csv",
    "epd-library.csv",
    "ffe/jobs/input-manifests"
  ],
  "delegation": "inherit-scope-target-permissions-and-evidence",
  "modes": [
    {
      "mode": "record-read",
      "required": [
        "file.read"
      ],
      "optional": []
    },
    {
      "mode": "record-write",
      "required": [
        "file.read",
        "file.write"
      ],
      "optional": []
    },
    {
      "mode": "delegate"
    }
  ],
  "execution": {
    "model": "harness-native",
    "contract": "docs/workspace-model.md",
    "operations": [
      "context.resolve",
      "project.init",
      "project.status",
      "project.vocab",
      "project.facts",
      "project.decision",
      "documents.resolve",
      "documents.register",
      "documents.query",
      "documents.move",
      "documents.verify"
    ]
  }
}
