{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.studio/schema/ffe-record.schema.json",
  "title": "Canonical FF&E Markdown fenced payload",
  "oneOf": [
    {
      "$ref": "#/$defs/item"
    },
    {
      "$ref": "#/$defs/schedule"
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "actor",
        "reason",
        "created_at",
        "previous_hash",
        "hash",
        "item_id",
        "tag",
        "fields",
        "provenance",
        "decision_refs"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "item_id": {
          "type": "string",
          "format": "uuid"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "supplied",
                  "verified",
                  "unknown",
                  "inferred"
                ]
              },
              "source": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "actor",
        "reason",
        "created_at",
        "previous_hash",
        "hash",
        "schedule_id",
        "name",
        "source",
        "lifecycle",
        "approval_refs",
        "item_refs"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schedule_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object"
        },
        "lifecycle": {
          "enum": [
            "proposed",
            "selected",
            "approved",
            "superseded"
          ]
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "revision",
              "hash",
              "path"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
