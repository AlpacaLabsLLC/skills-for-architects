{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FF&E audit input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "started_at",
    "items",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "live",
        "snapshot"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "revision",
          "tag",
          "fields"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "field",
          "value",
          "status",
          "source",
          "observed_at"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "status": {
            "enum": [
              "observed",
              "unavailable"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "locator"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
