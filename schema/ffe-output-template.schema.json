{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FF&E accepted template and output scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "audience",
    "allowed_fields",
    "template_accepted",
    "layout_requirements",
    "missing_image_policy",
    "combined_pdf",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "mode": {
      "enum": [
        "adopted",
        "one-off"
      ]
    },
    "audience": {
      "enum": [
        "client",
        "internal"
      ]
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "template_accepted": {
      "const": true
    },
    "layout_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_image_policy": {
      "enum": [
        "block",
        "labeled-placeholder"
      ]
    },
    "combined_pdf": {
      "type": "boolean"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "item_ids",
          "expected_pages"
        ],
        "properties": {
          "tag": {
            "$ref": "product-identity.schema.json#/$defs/tag"
          },
          "filename": {
            "$ref": "product-identity.schema.json#/$defs/filename",
            "description": "Version 2 only: explicit reversible filename mapping; tag remains exact. A safe tag defaults to tag.pdf."
          },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_pages": {
            "type": "integer",
            "minimum": 1
          },
          "images": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "source",
                "status"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "exact",
                    "representative"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "front_matter_pages": {
      "type": "integer",
      "minimum": 0
    },
    "reference_overrides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"outputs": {"items": {"not": {"required": ["filename"]}}}}}
    }
  ]
}
