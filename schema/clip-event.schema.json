{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only product URL clip event",
  "$defs": {
    "url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "redacted_components"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s]+$"
        },
        "redacted_components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(userinfo|fragment|path-secret|query:.+)$"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "manufacturer_sku",
        "vendor_item_id",
        "storefront_id"
      ],
      "properties": {
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer_sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendor_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "storefront_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "json": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_url",
        "configuration",
        "fingerprint"
      ],
      "properties": {
        "submitted_url": {
          "$ref": "#/$defs/url"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "capture_id",
        "request_id",
        "at",
        "action",
        "state",
        "request",
        "prior_capture_id"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "action": {
          "const": "clip"
        },
        "state": {
          "const": "started"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "prior_capture_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "capture_id",
        "request_id",
        "at",
        "action",
        "state",
        "outcome",
        "capture_path",
        "capture_sha256",
        "product"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "capture_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "action": {
          "const": "clip"
        },
        "state": {
          "const": "terminal"
        },
        "outcome": {
          "enum": [
            "success",
            "partial",
            "blocked",
            "login-required",
            "not-product",
            "file-reference",
            "unavailable",
            "failed"
          ]
        },
        "capture_path": {
          "type": "string",
          "pattern": "^captures/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.json$"
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "product": {
          "$ref": "#/$defs/product"
        }
      }
    }
  ]
}
