{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "path",
          "owner",
          "execution",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(skill|knowledge|tool|studio):[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "skills",
              "knowledge",
              "tools",
              "studio"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "instructions",
              "reference",
              "local-python",
              "local-node",
              "local-shell",
              "host",
              "external",
              "server",
              "unavailable"
            ]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "capability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "triggers",
              "exclusions",
              "inputs",
              "outputs",
              "references",
              "hostContract",
              "executionOwner",
              "handoffs"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "triggers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclusions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hostContract": {
                "type": "string",
                "minLength": 1
              },
              "executionOwner": {
                "enum": [
                  "host",
                  "server"
                ]
              },
              "conditionalReferences": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "when"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "handoffs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "when"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^skill:[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
