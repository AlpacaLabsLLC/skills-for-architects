{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "path",
          "owner",
          "execution",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(skill|knowledge|tool|studio):[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "skills",
              "knowledge",
              "tools",
              "studio"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "instructions",
              "reference",
              "local-python",
              "local-node",
              "local-shell",
              "host",
              "external",
              "server",
              "unavailable"
            ]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
